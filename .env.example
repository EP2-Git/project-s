# Public browser configuration. These values are safe to expose, but each
# installation must use its own Supabase project or local Supabase stack.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional. Defaults to the browser origin. The local Vite server proxies
# /api/v1 to Supabase Edge Functions; production must provide the same route.
VITE_PROJECT_S_API_URL=

# Optional in local development. Production public booking confirmation must
# configure the matching server-side challenge provider and secret.
VITE_PROJECT_S_TURNSTILE_SITE_KEY=

# Optional. Controls only the public website surface. Missing or invalid values
# resolve to the safe `self-hosted` behavior. Set `hosted` only for Project S's own
# hosted marketing deployment.
VITE_PROJECT_S_DEPLOYMENT_AUDIENCE=self-hosted

# Trusted API/Edge production configuration. Keep these server-side and
# configure them through your deployment secret store, never through VITE_*.
# `npm run db:start` writes a separate ignored development-only env file.
PROJECT_S_ENVIRONMENT=production
PROJECT_S_PUBLIC_APP_URL=https://project-s.example.invalid
PROJECT_S_ALLOWED_ORIGINS=https://project-s.example.invalid
PROJECT_S_RATE_LIMIT_HMAC_SECRET=
PROJECT_S_TRUST_PROXY_HEADERS=true
PROJECT_S_CHALLENGE_PROVIDER=turnstile
PROJECT_S_TURNSTILE_SECRET_KEY=
PROJECT_S_TURNSTILE_HOSTNAMES=

# Used by the local MCP subprocess. Point it at the origin serving /api/v1.
PROJECT_S_API_BASE_URL=http://127.0.0.1:8080
