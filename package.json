{
  "name": "project-s",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0-prealpha",
  "description": "Authority-bounded, self-hostable scheduling with one shared browser, HTTP, TypeScript SDK, and local MCP contract.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EP2-Git/project-s.git"
  },
  "bugs": {
    "url": "https://github.com/EP2-Git/project-s/issues"
  },
  "homepage": "https://github.com/EP2-Git/project-s#readme",
  "type": "module",
  "workspaces": [
    "packages/application",
    "packages/contracts",
    "packages/mcp-server",
    "packages/sdk"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "npm run build:packages && vite",
    "build": "npm run build:packages && vite build",
    "build:dev": "vite build --mode development",
    "build:contracts": "npm run build --workspace @project-s/contracts",
    "build:application": "npm run build --workspace @project-s/application",
    "build:sdk": "npm run build --workspace @project-s/sdk",
    "build:packages": "npm run build:contracts && npm run build:application && npm run build:sdk",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run build:packages && npm run typecheck:packages && tsc -p tsconfig.app.json --noEmit --pretty false && tsc -p tsconfig.node.json --noEmit --pretty false",
    "typecheck:packages": "npm run typecheck --workspace @project-s/contracts && npm run typecheck --workspace @project-s/application && npm run typecheck --workspace @project-s/sdk",
    "test": "npm run build:packages && vitest run && npm run test:contracts && npm run test:application && npm run test:sdk && npm run test:mcp && npm run test:parity",
    "test:contracts": "npm run test --workspace @project-s/contracts",
    "test:application": "npm run test --workspace @project-s/application",
    "test:sdk": "npm run test --workspace @project-s/sdk",
    "test:mcp": "node --test packages/mcp-server/tests/*.test.mjs",
    "test:parity": "npm run build:packages && node --test tests/parity/*.test.mjs",
    "test:agent-flow": "npm run build:packages && node scripts/check-agent-booking-flow.mjs",
    "test:watch": "vitest",
    "test:coverage": "npm run build:packages && vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit",
    "demo:authority": "npm run build:packages && node scripts/authority-boundary-demo.mjs",
    "demo:authority:capture": "node scripts/capture-authority-boundary-demo.mjs",
    "test:homepage:lab": "playwright test --config=playwright.design-lab.config.ts",
    "capture:homepage:lab": "node scripts/capture-hosted-homepage-lab.mjs",
    "test:homepage:selected:bundles": "npm run build:packages && node scripts/check-selected-homepage-bundles.mjs",
    "test:homepage:selected:ui": "playwright test --config=playwright.selected-homepage.config.ts",
    "test:homepage:selected": "npm run test:homepage:selected:bundles && npm run test:homepage:selected:ui",
    "capture:homepage:selected": "node scripts/capture-hosted-homepage-selected.mjs",
    "mcp:stdio": "npm run build:packages && node packages/mcp-server/src/bin.mjs",
    "db:edge-env": "node scripts/write-local-edge-env.mjs",
    "db:start": "npm run build:packages && npm run db:edge-env && supabase start",
    "db:stop": "supabase stop",
    "db:reset": "npm run build:packages && supabase db reset && node scripts/wait-for-local-db.mjs",
    "db:wait": "node scripts/wait-for-local-db.mjs",
    "db:status": "supabase status",
    "db:env": "node scripts/write-local-env.mjs",
    "db:lint": "supabase db lint --local --level warning --fail-on warning",
    "test:db": "supabase test db supabase/tests/database",
    "test:concurrency": "node scripts/check-booking-concurrency.mjs",
    "types:check": "node scripts/check-generated-types.mjs",
    "security:scan": "node scripts/scan-repository.mjs",
    "docs:check": "node scripts/check-repository-docs.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "audit": "npm audit --audit-level=high",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:coverage && npm run build && npm run audit:prod && npm run security:scan && npm run licenses:check",
    "check:full": "npm run check && npm run db:lint && npm run test:db && npm run test:concurrency && npm run types:check && npm run test:agent-flow && npm run test:e2e"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.43.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^7.18.2",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.1",
    "vaul": "^0.9.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.26",
    "supabase": "^2.115.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
